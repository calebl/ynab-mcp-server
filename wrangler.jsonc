{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ynab-mcp-server",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// Hourly. The job itself only acts in NAG_HOUR local time, so the reminder
	// keeps its wall-clock slot across daylight saving changes.
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"kv_namespaces": [
		{
			// OAuth grants and tokens. Create with:
			//   npx wrangler kv namespace create OAUTH_KV
			"binding": "OAUTH_KV",
			"id": "7bcc07072913466b93a2a333514741ed",
			"remote": true
		}
	],
	"vars": {
		// Non-secret config. Secrets (YNAB_API_TOKEN, GITHUB_CLIENT_SECRET)
		// are set with `wrangler secret put`, never here.
		"ALLOWED_GITHUB_LOGIN": "ianthebeard",
		"YNAB_READ_ONLY": "false",
		// Budget 2026. Not a secret — a budget id alone grants no access.
		"YNAB_BUDGET_ID": "82593cdb-bc22-4049-b04d-deaae054aa73",
		// Categorize reminder. GOOGLE_SERVICE_ACCOUNT_JSON is a secret; without
		// it the scheduled job is a no-op.
		"NAG_CALENDAR_ID": "262a792f16cf742caaee1325fe5bf225671a6f7cbc26a490bc05e92776d5dac6@group.calendar.google.com",
		"NAG_TIMEZONE": "America/Los_Angeles",
		"NAG_HOUR": "18"
	}
}