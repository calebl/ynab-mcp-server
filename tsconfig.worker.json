{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "lib": ["ESNext"]
  },
  "include": ["src/worker/**/*", "src/registry.ts", "src/tools/**/*", "src/tests/**/*"],
  "exclude": ["node_modules", "src/tests", "**/*.test.ts", "**/*.spec.ts"]
}
